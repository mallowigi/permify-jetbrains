<idea-plugin>
    <id>com.mallowigi.permify</id>
    <name>Permify</name>
    <vendor email="elior@material-theme.com" url="https://www.material-theme.com">Atom Material</vendor>

    <description><![CDATA[
        <h1>Permify Language Support</h1>
        <p>
            This plugin provides support for the <a href="https://permify.co">Permify authorization language</a> to JetBrains IDEs.
        </p>
        <h2>Features</h2>
        <ul>
            <li>Syntax Highlighting</li>
            <li>Basic Code Completion</li>
            <li>Automatic indentation (with editorConfig)</li>
            <li>Easy Commenting</li>
            <li>Bracket Matching</li>
            <li>Basic Snippets</li>
        </ul>
        ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="com.mallowigi.permify.PermifyTextMateBundleProvider"/>
        <liveTemplateContext contextId="Permify"
                             implementation="com.mallowigi.permify.PermifyTemplateContextType"
                             order="first"/>
        <defaultLiveTemplates file="templates/permify.xml"/>

        <fileIconProvider implementation="com.mallowigi.permify.PermifyFileIconProvider"/>

        <fileType name="permify"
                  language="permify"
                  fieldName="INSTANCE"
                  implementationClass="com.mallowigi.permify.PermifyFileType"
                  extensions="perm"/>

        <lang.parserDefinition
                language="permify"
                implementationClass="com.mallowigi.permify.lang.PermifyParserDefinition"/>
        <lang.ast.factory language="permify" implementationClass="com.mallowigi.permify.lang.PermifyASTFactory"/>

        <lang.syntaxHighlighterFactory language="permify"
                                       implementationClass="com.mallowigi.permify.highlighter.PermifySyntaxHighlighterFactory"/>
        <lang.commenter language="permify" implementationClass="com.mallowigi.permify.commenter.PermifyCommenter"/>
        <lang.braceMatcher language="permify" implementationClass="com.mallowigi.permify.lang.PermifyBraceMatcher"/>
        <lang.psiStructureViewFactory language="permify"
                                      implementationClass="com.mallowigi.permify.lang.PermifyStructureViewFactory"/>
        <annotator language="permify" implementationClass="com.mallowigi.permify.annotator.PermifyAnnotator"/>
        <psi.referenceContributor language="permify"
                                  implementation="com.mallowigi.permify.reference.PermifyReferenceContributor"/>

        <colorSettingsPage implementation="com.mallowigi.permify.settings.PermifyColorSettings"/>

        <formattingService implementation="com.mallowigi.permify.formatter.PermifyFormattingService"/>

        <langCodeStyleSettingsProvider
                implementation="com.mallowigi.permify.formatter.PermifyLanguageCodeStyleSettingsProvider"/>


        <!--<treeStructureProvider implementation="com.mallowigi.permify.treeStructure.PermifyTreeStructureProvider"/>-->

    </extensions>
</idea-plugin>
